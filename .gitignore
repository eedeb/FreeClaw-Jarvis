# Secrets and machine-specific config, written by setup.py — see
# src/jarvis_config.py. Holds the FreeClaw password and the loopback control
# token; never commit it.
src/jarvis_config.json

# The marker install.ps1 writes; distinguishes an install from a source
# checkout the way FreeClaw's .freeclaw-install does. A checkout should never
# have one, so this stays gitignored the same way.
.jarvis-install

# Runtime output — logs, and screenshots the MCP server's take_screenshot
# tool writes into. Both directories are created on demand; neither needs to
# exist in the repo.
src/logs/
src/screenshots/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Local dev environment created by installer/dev docs, never the app's own.
python/

# Generated by windows/make_icon.py purely so the mark can be eyeballed
# without opening the .ico — not shipped or referenced anywhere.
windows/icon-preview.png

# OS cruft
Thumbs.db
desktop.ini
.DS_Store
