# Windows batch files must keep CRLF line endings on checkout, on every
# platform. cmd.exe reads a .cmd in the OEM codepage and mis-parses bare LF:
# the `rem` lines stop being comments and it tries to run them as commands.
# Without this, a clone on Linux/macOS - or a repo with core.autocrlf=input -
# stages LF, and every `jarvis` invocation prints a screenful of "is not
# recognized" before it works.
*.cmd text eol=crlf
*.bat text eol=crlf

# PowerShell scripts keep CRLF too. install.ps1 and uninstall.ps1 are also
# deliberately pure ASCII: they are fetched and run with `irm ... | iex`,
# which decodes the raw bytes, and a BOM or a stray non-ASCII character in
# that path is a parse error rather than a rendering glitch.
*.ps1 text eol=crlf

# Binary assets - never touched by line-ending normalization.
*.png binary
*.ico binary
*.ttf binary
*.wav binary
*.mp3 binary

# Everything else: normalize to LF in the repo, checked out as the
# platform's own convention.
* text=auto
